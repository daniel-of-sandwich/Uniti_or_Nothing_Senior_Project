          "queryText": "SELECT \n  cve_id, \n  host, \n  risk, \n  cvss_score,\n  protocol, \n  port, \n  name, \n  scan_date,\n  scan_name\nFROM vulnerabilities\nWHERE ('{CVE-1999-0524,CVE-1999-0511,CVE-2007-1858,CVE-2020-11022,CVE-2020-11023,CVE-2013-2566,CVE-2015-2808,CVE-1999-0517,CVE-2016-2183}' = 'All' OR cve_id IN ('CVE-1999-0524','CVE-1999-0511','CVE-2007-1858','CVE-2020-11022','CVE-2020-11023','CVE-2013-2566','CVE-2015-2808','CVE-1999-0517','CVE-2016-2183')) \nAND ('{192.168.50.1,192.168.50.188,192.168.50.245,10.20.120.1,192.168.137.70,192.168.0.1,192.168.0.21,192.168.0.25,192.168.0.26,192.168.0.6,192.168.0.7,192.168.0.9,192.168.0.22,192.168.0.23,192.168.0.28}' = 'All' OR host IN ('192.168.50.1','192.168.50.188','192.168.50.245','10.20.120.1','192.168.137.70','192.168.0.1','192.168.0.21','192.168.0.25','192.168.0.26','192.168.0.6','192.168.0.7','192.168.0.9','192.168.0.22','192.168.0.23','192.168.0.28'))\nAND ('{Critical,High,Medium,Low}' = 'All' OR risk IN ('Critical','High','Medium','Low'))\nORDER BY \n  cvss_score DESC,\n  CASE WHEN risk = 'Critical' THEN 1\n       WHEN risk = 'High' THEN 2\n       WHEN risk = 'Medium' THEN 3\n       WHEN risk = 'Low' THEN 4\n       ELSE 5\n  END,\n  host, port",
          "queryType": "table",
          "rawQueryText": "SELECT \n  cve_id, \n  host, \n  risk, \n  cvss_score,\n  protocol, \n  port, \n  name, \n  scan_date,\n  scan_name\nFROM vulnerabilities\nWHERE ('$CVE_Filter' = 'All' OR cve_id IN (${CVE_Filter:sqlstring})) \nAND ('$Host_Filter' = 'All' OR host IN (${Host_Filter:sqlstring}))\nAND ('$Risk_Filter' = 'All' OR risk IN (${Risk_Filter:sqlstring}))\nORDER BY \n  cvss_score DESC,\n  CASE WHEN risk = 'Critical' THEN 1\n       WHEN risk = 'High' THEN 2\n       WHEN risk = 'Medium' THEN 3\n       WHEN risk = 'Low' THEN 4\n       ELSE 5\n  END,\n  host, port",
          "refId": "A",
          "timeColumns": [
