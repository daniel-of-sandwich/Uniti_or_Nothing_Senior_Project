      "targets": [
        {
          "queryText": "SELECT \n  cve_id AS CVE, \n  host AS Host, \n  risk AS Risk, \n  cvss_score AS CVSS,\n  protocol AS Protocol, \n  port AS Port, \n  name AS Name, \n  MAX(scan_date) AS Scan_Date,\n  scan_name AS Raw_File,\n  CASE WHEN is_new_scan = 1 THEN 'New' ELSE '' END as Scan_Status\nFROM vulnerabilities\nWHERE ('$CVE_Filter' = 'All' OR cve_id IN (${CVE_Filter:sqlstring})) \nAND ('$Host_Filter' = 'All' OR host IN (${Host_Filter:sqlstring}))\nAND ('$Risk_Filter' = 'All' OR risk IN (${Risk_Filter:sqlstring}))\nGROUP BY host, port, protocol, name\nORDER BY \n  MAX(cvss_score) DESC,\n  MAX(scan_date) DESC,\n  CASE WHEN risk = 'Critical' THEN 1\n       WHEN risk = 'High' THEN 2\n       WHEN risk = 'Medium' THEN 3\n       WHEN risk = 'Low' THEN 4\n       ELSE 5\n  END,\n  host, port",
          "queryType": "table",
          "rawQueryText": "SELECT \n  cve_id AS CVE, \n  host AS Host, \n  risk AS Risk, \n  cvss_score AS CVSS,\n  protocol AS Protocol, \n  port AS Port, \n  name AS Name, \n  MAX(scan_date) AS Scan_Date,\n  scan_name AS Raw_File,\n  CASE WHEN is_new_scan = 1 THEN 'New' ELSE '' END as Scan_Status\nFROM vulnerabilities\nWHERE ('$CVE_Filter' = 'All' OR cve_id IN (${CVE_Filter:sqlstring})) \nAND ('$Host_Filter' = 'All' OR host IN (${Host_Filter:sqlstring}))\nAND ('$Risk_Filter' = 'All' OR risk IN (${Risk_Filter:sqlstring}))\nGROUP BY host, port, protocol, name\nORDER BY \n  MAX(cvss_score) DESC,\n  MAX(scan_date) DESC,\n  CASE WHEN risk = 'Critical' THEN 1\n       WHEN risk = 'High' THEN 2\n       WHEN risk = 'Medium' THEN 3\n       WHEN risk = 'Low' THEN 4\n       ELSE 5\n  END,\n  host, port",
          "refId": "A",
          "timeColumns": [
            "time",
            "ts",
            "scan_date"
          ]
        }
      ],
      "title": "Scan Results",
      "type": "table"
