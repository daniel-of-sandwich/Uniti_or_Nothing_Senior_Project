            "uid": "${DS_FRSER-SQLITE-DATASOURCE}"
          },
          "queryText": "SELECT DISTINCT h.Host AS 'Host', h.new_host AS 'New', s.last_modification_date AS 'Date Detected', s.name AS 'Scan', f.name AS 'Folder'\nFROM Host AS h\nINNER JOIN Scan AS s ON h.scan_id = s.id\nINNER JOIN Folder AS f ON s.folder_id = f.id\nORDER BY h.new_host DESC, s.last_modification_date DESC, h.scan_id DESC, h.Host ASC;",
          "queryType": "table",
          "rawQueryText": "SELECT DISTINCT h.Host AS 'Host', h.new_host AS 'New', s.last_modification_date AS 'Date Detected', s.name AS 'Scan', f.name AS 'Folder'\nFROM Host AS h\nINNER JOIN Scan AS s ON h.scan_id = s.id\nINNER JOIN Folder AS f ON s.folder_id = f.id\nORDER BY h.new_host DESC, s.last_modification_date DESC, h.scan_id DESC, h.Host ASC;",
