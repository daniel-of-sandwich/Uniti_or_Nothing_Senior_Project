        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_FRSER-SQLITE-DATASOURCE}"
          },
          "hide": false,
          "queryText": "SELECT v.CVSS_v2_0_Base_Score AS 'CVSS Score', v.Risk AS 'Severity', \r\n  v.new_vuln AS 'New', s.last_modification_date AS 'Last Detected', \r\n  v.CVE AS 'CVE', v.[Host] AS 'Host', v.Port AS 'Port', v.Protocol AS 'Protocol', \r\n  v.Name AS 'Type', s.name AS 'Scan', f.name AS 'Folder'\r\nFROM Vulnerability AS v\r\nINNER JOIN Scan AS s ON v.scan_id=s.id\r\nINNER JOIN Folder AS f ON s.folder_id=f.id\r\nORDER BY v.new_vuln DESC, v.CVSS_v2_0_Base_Score DESC, s.last_modification_date DESC, s.name DESC;",
          "queryType": "table",
          "rawQueryText": "SELECT v.CVSS_v2_0_Base_Score AS 'CVSS Score', v.Risk AS 'Severity', \r\n  v.new_vuln AS 'New', s.last_modification_date AS 'Last Detected', \r\n  v.CVE AS 'CVE', v.[Host] AS 'Host', v.Port AS 'Port', v.Protocol AS 'Protocol', \r\n  v.Name AS 'Type', s.name AS 'Scan', f.name AS 'Folder'\r\nFROM Vulnerability AS v\r\nINNER JOIN Scan AS s ON v.scan_id=s.id\r\nINNER JOIN Folder AS f ON s.folder_id=f.id\r\nORDER BY v.new_vuln DESC, v.CVSS_v2_0_Base_Score DESC, s.last_modification_date DESC, s.name DESC;",
          "refId": "A",
          "timeColumns": [
            "Last Detected"
          ]
        }
      ],
