        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_FRSER-SQLITE-DATASOURCE}"
          },
          "hide": false,
          "queryText": "SELECT v.CVSS_v2_0_Base_Score AS 'CVSS v2.0', v.Risk AS 'Severity', v.CVE AS 'CVE', v.[Host] AS 'Host', v.Port AS 'Port', \r\n  v.Protocol AS 'Protocol', v.Name AS 'Name', s.last_modification_date AS 'Last Detected', v.new_vuln AS 'New', \r\n  s.name AS 'Scan Name', f.name AS 'Folder Name'\r\nFROM Vulnerability AS v\r\nINNER JOIN Scan AS s ON v.scan_id=s.id\r\nINNER JOIN Folder AS f ON s.folder_id=f.id;",
          "queryType": "table",
          "rawQueryText": "SELECT v.CVSS_v2_0_Base_Score AS 'CVSS v2.0', v.Risk AS 'Severity', v.CVE AS 'CVE', v.[Host] AS 'Host', v.Port AS 'Port', \r\n  v.Protocol AS 'Protocol', v.Name AS 'Name', s.last_modification_date AS 'Last Detected', v.new_vuln AS 'New', \r\n  s.name AS 'Scan Name', f.name AS 'Folder Name'\r\nFROM Vulnerability AS v\r\nINNER JOIN Scan AS s ON v.scan_id=s.id\r\nINNER JOIN Folder AS f ON s.folder_id=f.id;",
          "refId": "A",
          "timeColumns": [
            "Last Detected"
          ]
        }
      ],
